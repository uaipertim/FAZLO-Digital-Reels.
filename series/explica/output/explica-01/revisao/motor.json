 "apoios": [
  {
   "cap": 0,
   "i": 0,
   "texto": "Vamos montar juntos, parte por parte?",
   "t": 4.369,
   "inteira_de": 4.709,
   "ate": 7.11
  },
  {
   "cap": 1,
   "i": 0,
   "texto": "A primeira parte é o topo do site.",
   "t": 7.96,
   "inteira_de": 8.3,
   "ate": 9.82
  },
  {
   "cap": 1,
   "i": 1,
   "texto": "Que lugar é, onde fica e por que vale a viagem.",
   "t": 10.02,
   "inteira_de": 10.36,
   "ate": 16.178
  },
  {
   "cap": 2,
   "i": 0,
   "texto": "A segunda parte é a consulta de datas, logo abaixo do topo.",
   "t": 17.028,
   "inteira_de": 17.368,
   "ate": 20.842000000000002
  },
  {
   "cap": 2,
   "i": 1,
   "texto": "Entrada, saída e quantas pessoas.",
   "t": 21.042,
   "inteira_de": 21.382,
   "ate": 24.12
  },
  {
   "cap": 3,
   "i": 0,
   "texto": "A terceira parte são os quartos.",
   "t": 24.97,
   "inteira_de": 25.31,
   "ate": 26.830000000000002
  },
  {
   "cap": 3,
   "i": 1,
   "texto": "Fotos, quantas pessoas e um “a partir de”.",
   "t": 27.03,
   "inteira_de": 27.37,
   "ate": 33.92
  },
  {
   "cap": 4,
   "i": 0,
   "texto": "A quarta parte é o que está incluso.",
   "t": 34.77,
   "inteira_de": 35.11000000000001,
   "ate": 37.052
  },
  {
   "cap": 4,
   "i": 1,
   "texto": "Café, horários e pet: tudo respondido.",
   "t": 37.252,
   "inteira_de": 37.592000000000006,
   "ate": 42.137
  },
  {
   "cap": 4,
   "i": 2,
   "texto": "O que vira pergunta no direct fica escrito.",
   "t": 42.337,
   "inteira_de": 42.67700000000001,
   "ate": 46.646
  },
  {
   "cap": 5,
   "i": 0,
   "texto": "A quinta parte é como chegar.",
   "t": 47.496,
   "inteira_de": 47.836000000000006,
   "ate": 49.355999999999995
  },
  {
   "cap": 5,
   "i": 1,
   "texto": "O mapa e as referências de quem é da região.",
   "t": 49.556,
   "inteira_de": 49.896,
   "ate": 52.818999999999996
  },
  {
   "cap": 5,
   "i": 2,
   "texto": "Ele chega tranquilo, sem perguntar de novo.",
   "t": 53.019,
   "inteira_de": 53.359,
   "ate": 56.423
  },
  {
   "cap": 6,
   "i": 0,
   "texto": "A sexta parte é a mensagem.",
   "t": 57.273,
   "inteira_de": 57.61300000000001,
   "ate": 59.132999999999996
  },
  {
   "cap": 6,
   "i": 1,
   "texto": "Chega já preenchida: datas, pessoas e quarto.",
   "t": 59.333,
   "inteira_de": 59.673,
   "ate": 64.535
  },
  {
   "cap": 6,
   "i": 2,
   "texto": "Você só responde.",
   "t": 64.735,
   "inteira_de": 65.075,
   "ate": 66.745
  },
  {
   "cap": 7,
   "i": 0,
   "texto": "A sétima parte é o celular.",
   "t": 67.595,
   "inteira_de": 67.935,
   "ate": 69.459
  },
  {
   "cap": 7,
   "i": 1,
   "texto": "É nele que o hóspede procura, até na estrada.",
   "t": 69.659,
   "inteira_de": 69.99900000000001,
   "ate": 72.5
  },
  {
   "cap": 7,
   "i": 2,
   "texto": "Abrir rápido e caber na tela, sem zoom.",
   "t": 72.7,
   "inteira_de": 73.04,
   "ate": 76.94
  },
  {
   "cap": 8,
   "i": 0,
